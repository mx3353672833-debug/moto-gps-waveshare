{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moto-gps.local/schema/route-bundle.v1.schema.json",
  "title": "RouteBundleEnvelopeV1",
  "description": "Versioned route response consumed by both WebAssembly and ESP32 targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "route"],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "description": "Exact echo of the request identifier; consumers must ignore a response that is no longer active."
    },
    "route": {
      "$ref": "#/$defs/routeBundle"
    }
  },
  "$defs": {
    "routeBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "route_id",
        "provider",
        "coordinate_system",
        "generated_at_ms",
        "total_distance_m",
        "total_duration_s",
        "polyline",
        "maneuvers",
        "traffic"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "route_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "provider": {
          "const": "amap"
        },
        "coordinate_system": {
          "const": "GCJ-02",
          "description": "Every point in this bundle is GCJ-02. WGS84 GNSS fixes must cross the same explicit transform boundary before matching."
        },
        "generated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "total_duration_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "polyline": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/gcj02Point"
          }
        },
        "maneuvers": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/maneuver"
          }
        },
        "traffic": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/trafficSegment"
          }
        }
      }
    },
    "gcj02Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude_deg", "latitude_deg"],
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "maneuver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "route_offset_m",
        "road_name",
        "instruction",
        "roundabout_exit"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "type": {
          "enum": [
            "unknown",
            "continue",
            "slight_left",
            "left",
            "sharp_left",
            "u_turn_left",
            "slight_right",
            "right",
            "sharp_right",
            "u_turn_right",
            "roundabout",
            "exit",
            "arrive"
          ]
        },
        "route_offset_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "road_name": {
          "type": "string",
          "maxLength": 96
        },
        "instruction": {
          "type": "string",
          "maxLength": 256
        },
        "roundabout_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "trafficSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_offset_m", "end_offset_m", "level"],
      "properties": {
        "start_offset_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_offset_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "level": {
          "enum": ["unknown", "free_flow", "slow", "congested", "severe"]
        }
      }
    }
  }
}
